<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vista árbol -->
        <record id="ztyres_products_treadwear_tree" model="ir.ui.view">
            <field name="name">ztyres_products.treadwear.tree</field>
            <field name="model">ztyres_products.treadwear</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="number"/>
                </tree>
            </field>
        </record>

        <!-- Vista formulario -->
        <record id="ztyres_products_treadwear_form" model="ir.ui.view">
            <field name="name">ztyres_products.treadwear.form</field>
            <field name="model">ztyres_products.treadwear</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="number"/>
                            <field name="name" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acción -->
        <record id="ztyres_products.treadwear_action" model="ir.actions.act_window">
            <field name="name">Índice Treadwear</field>
            <field name="res_model">ztyres_products.treadwear</field>
            <field name="view_mode">tree,form</field>
        </record>



    </data>
</odoo>
