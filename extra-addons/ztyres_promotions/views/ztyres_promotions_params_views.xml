<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Vista de parámetros de sistema de Promociones.
            Abre ir.config_parameter filtrado por el prefijo del módulo.
            El botón "Inicializar defaults" ejecuta init_defaults() para
            sembrar todos los parámetros que aún no existan.
        -->

        <!-- Acción: lista parámetros del módulo -->
        <record id="action_promotion_params" model="ir.actions.act_window">
            <field name="name">Parámetros de Promociones</field>
            <field name="res_model">ir.config_parameter</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('key', 'like', 'ztyres_promotions.')]</field>
            <field name="context">{'search_default_group_by_key': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No hay parámetros de promociones todavía.
                </p>
                <p>
                    Usa el botón <b>Inicializar defaults</b> para crear todos
                    los parámetros del registro con sus valores por defecto,
                    o añádelos manualmente con la clave
                    <code>ztyres_promotions.&lt;SUFIJO&gt;</code>.
                </p>
                <p>
                    Estos parámetros están disponibles en las reglas de
                    promoción como <code>params['SUFIJO']</code> o
                    <code>param('SUFIJO')</code>.
                </p>
            </field>
        </record>

        <!-- Acción servidor: inicializar defaults -->
        <record id="action_init_promotion_params" model="ir.actions.server">
            <field name="name">Inicializar parámetros de Promociones</field>
            <field name="model_id" ref="model_ztyres_promotions_config_param"/>
            <field name="state">code</field>
            <field name="code">
env['ztyres_promotions.config.param'].init_defaults()
            </field>
        </record>

    </data>
</odoo>
