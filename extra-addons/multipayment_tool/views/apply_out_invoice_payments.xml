<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="view_apply_out_invoice_payments_form_inherit" model="ir.ui.view">
            <field name="name">apply_payments.view_apply_out_invoice_payments_form_inherit</field>
            <field name="model">apply_out_invoice.payments</field>
            <field name="inherit_id" ref="apply_payments.view_apply_out_invoice_payments_form" />
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="get_detailed_info" type="object" string="Obtener Detalle de Pagos"/>
                    <button name="apply_payments" type="object" string="Aplicar Pagos" class="btn-primary"/>     
                </xpath>
                <field name='outstanding_amount' position='before'>
                    <field name="payment_amount"/>
                    <field name="amount_resudual_payments"/>
                    <field name='move_ids' domain="[('state','=','posted'),('move_type','=','out_invoice'),('amount_residual', '>', 0),('partner_id', '=', partner_id)]" widget="many2many_tags"/>
                </field>
        <field name="partner_id" position="attributes">
            <attribute name="force_save">1</attribute>
        </field>            
        <field name="payment_id" position="attributes">
            <attribute name="force_save">1</attribute>
        </field>   
        <field name="l10n_mx_edi_payment_method_id" position="attributes">
            <attribute name="force_save">1</attribute>
        </field>   

                <xpath expr="//button[@name='apply_payments' and contains(@class, 'btn-default')]" position="replace"/>

                <xpath expr="//field[@name='lines']/tree/field[@name='payment_amount']" position="after">
                    <button name="get_payments_line" type="object" string="Ver pagos"/>
                </xpath>
                <xpath expr="//field[@name='lines']/tree" position="attributes">
                    <attribute name="edit">false</attribute>
                    <attribute name="create">false</attribute>
                    <attribute name="delete">false</attribute>
                </xpath>
                
            </field>
        </record>
    
    </data>
</odoo>