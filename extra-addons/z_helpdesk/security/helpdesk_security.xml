<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_z_helpdesk" model="ir.module.category">
            <field name="name">Solicitudes internas</field>
            <field name="description">Permisos para solicitar atención sin administrar equipos de Helpdesk.</field>
            <field name="sequence">35</field>
        </record>

        <record id="group_ticket_requester" model="res.groups">
            <field name="name">Solicitante de tickets</field>
            <field name="category_id" ref="z_helpdesk.module_category_z_helpdesk"/>
        </record>
    </data>

    <record id="group_ticket_all_access" model="res.groups">
        <field name="name">Acceso a todos los tickets</field>
        <field name="category_id" ref="z_helpdesk.module_category_z_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('helpdesk.group_helpdesk_user'))]"/>
        <field name="comment">Puede consultar y atender todos los tickets, aunque no pertenezca al equipo ni esté asignado.</field>
    </record>

    <record id="helpdesk_ticket_rule_own_unassigned" model="ir.rule">
        <field name="name">El solicitante puede consultar sus propios tickets</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('z_helpdesk.group_ticket_requester'))]"/>
        <field name="domain_force">['|', ('requester_user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Un usuario puede conservar el grupo Solicitante de tickets y, más tarde,
        recibir permisos nativos de Helpdesk. Esta regla amplia evita que la
        regla de tickets propios siga limitando a agentes y administradores.
        group_helpdesk_manager hereda group_helpdesk_user en Odoo.
    -->
    <record id="helpdesk_ticket_rule_helpdesk_all" model="ir.rule">
        <field name="name">Los agentes de Servicio de asistencia pueden consultar todos los tickets</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('helpdesk.group_helpdesk_user')), (4, ref('helpdesk.group_helpdesk_manager')), (4, ref('z_helpdesk.group_ticket_all_access'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="helpdesk_sla_status_rule_own_ticket" model="ir.rule">
        <field name="name">Estados SLA de los tickets propios del solicitante</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_sla_status"/>
        <field name="groups" eval="[(4, ref('z_helpdesk.group_ticket_requester'))]"/>
        <field name="domain_force">['|', ('ticket_id.requester_user_id', '=', user.id), ('ticket_id.create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="helpdesk_sla_status_rule_helpdesk_all" model="ir.rule">
        <field name="name">Los agentes de Servicio de asistencia pueden consultar todos los estados SLA</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_sla_status"/>
        <field name="groups" eval="[(4, ref('helpdesk.group_helpdesk_user')), (4, ref('helpdesk.group_helpdesk_manager')), (4, ref('z_helpdesk.group_ticket_all_access'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
