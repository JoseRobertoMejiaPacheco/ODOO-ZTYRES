<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="helpdesk_stage_new" model="helpdesk.stage">
            <field name="name">Nuevo</field>
            <field name="sequence">10</field>
            <field name="fold" eval="False"/>
        </record>

        <record id="helpdesk_stage_in_progress" model="helpdesk.stage">
            <field name="name">En proceso</field>
            <field name="sequence">20</field>
            <field name="fold" eval="False"/>
        </record>

        <record id="helpdesk_stage_waiting_other_area" model="helpdesk.stage">
            <field name="name">En espera de otra área</field>
            <field name="sequence">30</field>
            <field name="fold" eval="False"/>
        </record>

        <record id="helpdesk_stage_closed" model="helpdesk.stage">
            <field name="name">Cerrado</field>
            <field name="sequence">40</field>
            <field name="fold" eval="True"/>
        </record>
    </data>
</odoo>
