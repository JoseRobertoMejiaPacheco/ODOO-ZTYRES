<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_account_payment_form_inherit_ztyres" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.ztyres</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <!-- Campos invisibles para control interno -->
            <xpath expr="//sheet" position="inside">
                <field name="show_action_draft" invisible="1"/>
                <field name="can_cancel_edi" invisible="1"/>
            </xpath>

            <!-- Modificamos el botón action_draft -->
            <xpath expr="//button[@name='action_draft']" position="attributes">
                <attribute name="attrs">{'invisible': [('can_cancel_edi','=', False)]}</attribute>
            </xpath>

            <!-- Agregamos una nueva sección con nuestros campos -->
            <xpath expr="//sheet" position="inside">
                <group string="Autorizaciones" groups="ztyres.group_cancel" attrs="{'invisible': [('state','in', ['draft', 'cancel'])]}">
                    <!-- Campos auxiliares invisibles -->
                    <field name="can_edit_solicitar_cancelacion" invisible="1"/>
                    <field name="can_edit_firma_calidad" invisible="1"/>
                    <field name="can_edit_firma_finanzas" invisible="1"/>

                        <!-- Campos visibles con attrs según grupo -->
                    <field name="solicitar_cancelacion" 
                           attrs="{'readonly': [('can_edit_solicitar_cancelacion','=',False)]}"/>

                    <field name="firma_calidad" 
                           attrs="{'readonly': [('can_edit_firma_calidad','=',False)], 
                                   'invisible': [('solicitar_cancelacion','=',False)]}"/>

                    <field name="firma_finanzas" 
                           attrs="{'readonly': [('can_edit_firma_finanzas','=',False)], 
                                    'invisible': [('firma_calidad','=',False)]}"/>
                </group>
            </xpath>

        </field>
    </record>

    <record id="view_move_filter_inherit_extra" model="ir.ui.view">
        <field name="name">account.payment.filter.inherit.extra</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">

            <!-- Localiza el segundo separador y agrega el filtro justo antes -->
            <xpath expr="//filter[@name='to_check']/following-sibling::separator[1]" position="before">
                <filter string="Por cancelar" name="to_cancel" domain="[('state', '=', 'posted'), ('solicitar_cancelacion', '=', True)]"/>
            </xpath>

        </field>
    </record>

