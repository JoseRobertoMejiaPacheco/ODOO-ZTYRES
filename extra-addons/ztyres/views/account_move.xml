<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="show_partner_credit_alert" invisible="1"/>
                <div groups="account.group_account_invoice,account.group_account_readonly"
                     class="alert alert-info mb-0" role="alert"
                     attrs="{'invisible': ['|', '|', ('state', '!=', 'draft'), ('move_type', '!=', 'out_invoice'), ('show_partner_credit_alert', '=', False)]}">
                    I<b>nformación de crédito :</b>                        
                    Crédito usado : <b><field name="partner_credit_limit_used"/></b>.
                    Crédito disponible : <b><field name="partner_credit_limit_available"/></b>.
                    Límite de Crédito : <b><field name="partner_credit_limit"/></b>.
                    Saldo Vencido : <b><field name="partner_credit_amount_overdue"/></b>.
                </div>
            </xpath>
        </field>
    </record>


    <!--VISTA PARA SOLICITAR CANCELACION-->

    <record id="view_move_form_inherit_checkboxes" model="ir.ui.view">
        <field name="name">account.move.form.inherit.checkboxes</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Campo auxiliar para controlar visibilidad del botón EDI, accesible para todos -->
            <xpath expr="//sheet/notebook" position="inside">
                <field name="show_edi_cancel_button_final" invisible="1"/>
            </xpath>

            <xpath expr="//sheet/notebook" position="inside">
                <field name="can_cancel_edi" invisible="1"/>
            </xpath>
            
            <xpath expr="//button[@name='button_cancel_posted_moves']" position="attributes">
                <attribute name="attrs">{'invisible': [('can_cancel_edi','=',False)]}
                </attribute>
            </xpath>

            <!-- Agregar página de Autorizaciones con campos auxiliares y checks -->
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Autorizaciones" groups="ztyres.group_cancel" attrs="{'invisible': [('state','in', ['draft', 'cancel'])]}">
                    <group>
                        <!-- Campos auxiliares invisibles para controlar readonly -->
                        <field name="can_edit_solicitar_cancelacion" invisible="1"/>
                        <field name="can_edit_firma_calidad" invisible="1"/>
                        <field name="can_edit_firma_finanzas" invisible="1"/>

                        <!-- Campos visibles con attrs según grupo -->
                        <field name="solicitar_cancelacion" 
                            attrs="{'readonly': [('can_edit_solicitar_cancelacion','=',False)]}"/>

                        <field name="firma_calidad" 
                            attrs="{'readonly': [('can_edit_firma_calidad','=',False)], 
                                    'invisible': [('solicitar_cancelacion','=',False)]}"/>

                        <field name="firma_finanzas" 
                            attrs="{'readonly': [('can_edit_firma_finanzas','=',False)], 
                                    'invisible': [('firma_calidad','=',False)]}"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <record id="view_move_filter_inherit_extra" model="ir.ui.view">
        <field name="name">account.move.filter.inherit.extra</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">

            <!-- Localiza el segundo separador y agrega el filtro justo antes -->
            <xpath expr="//filter[@name='to_check']/following-sibling::separator[1]" position="before">
                <filter string="Por cancelar" name="to_cancel" domain="[('state', '=', 'posted'), ('solicitar_cancelacion', '=', True)]"/>
            </xpath>

        </field>
    </record>



