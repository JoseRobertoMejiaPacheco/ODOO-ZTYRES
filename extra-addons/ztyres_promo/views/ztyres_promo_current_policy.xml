<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
    <!-- Vistas para Current Policy Volume (Cantidad) -->
    <record id="view_current_policy_qty_tree" model="ir.ui.view">
        <field name="name">ztyres_promo.current_policy_qty.tree</field>
        <field name="model">ztyres_promo.current_policy_qty</field>
        <field name="arch" type="xml">
            <tree string="Políticas por Cantidad">
                <field name="lower_limit"/>
                <field name="upper_limit"/>
                <field name="min_qty"/>
                <field name="discount"/>
                <field name="fixed_amount"/>
                <field name="notas_credito_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_current_policy_qty_form" model="ir.ui.view">
        <field name="name">ztyres_promo.current_policy_qty.form</field>
        <field name="model">ztyres_promo.current_policy_qty</field>
        <field name="arch" type="xml">
            <form string="Política por Cantidad">
                <sheet>
                    <group>
                        <group>
                            <field name="lower_limit"/>
                            <field name="upper_limit"/>
                        </group>
                        <group>
                            <field name="min_qty"/>
                            <field name="discount"/>
                            <field name="fixed_amount"/>
                        </group>
                    </group>
                    <field name="notas_credito_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vistas para Current Policy Volume Amount (Monto) -->
    <record id="view_current_policy_amount_tree" model="ir.ui.view">
        <field name="name">ztyres_promo.current_policy_amount.tree</field>
        <field name="model">ztyres_promo.current_policy_amount</field>
        <field name="arch" type="xml">
            <tree string="Políticas por Monto">
                <field name="lower_limit"/>
                <field name="upper_limit"/>
                <field name="min_qty"/>
                <field name="discount"/>
                <field name="fixed_amount"/>
                <field name="notas_credito_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_current_policy_amount_form" model="ir.ui.view">
        <field name="name">ztyres_promo.current_policy_amount.form</field>
        <field name="model">ztyres_promo.current_policy_amount</field>
        <field name="arch" type="xml">
            <form string="Política por Monto">
                <sheet>
                    <group>
                        <group>
                            <field name="lower_limit"/>
                            <field name="upper_limit"/>
                        </group>
                        <group>
                            <field name="min_qty"/>
                            <field name="discount"/>
                            <field name="fixed_amount"/>
                        </group>
                    </group>
                    <field name="notas_credito_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_amount_rim_tier_form" model="ir.ui.view">
        <field name="name">ztyres_promo.amount.rim.tier.form</field>
        <field name="model">ztyres_promo.current_policy_amount</field>
        <field name="arch" type="xml">
            <form string="Tramo de monto y porcentajes por RIN">
                <sheet>
                    <group>
                        <group>
                            <field name="lower_limit" string="Desde ($ con IVA)"/>
                            <field name="upper_limit" string="Hasta ($ con IVA)"/>
                        </group>
                        <group>
                            <field name="min_qty"/>
                        </group>
                    </group>
                    <separator string="Porcentajes por rango de RIN"/>
                    <div class="alert alert-info" role="alert">
                        Los rangos son libres. Ejemplo: 14 a 16 y 17 a 99.
                        Si mañana cambia a R13-R15 y R16+, solo edita estos renglones.
                        Usa 99 como límite superior para representar “en adelante”.
                    </div>
                    <field name="rim_discount_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="rim_from"/>
                            <field name="rim_to"/>
                            <field name="discount"/>
                            <field name="key_size_discount" string="Key Size (%)"/>
                        </tree>
                    </field>
                    <field name="notas_credito_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    </data>
</odoo>
