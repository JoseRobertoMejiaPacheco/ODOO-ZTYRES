<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="view_coupon_excel_wizard_form" model="ir.ui.view">
            <field name="name">ztyres.promo.coupon.excel.wizard.form</field>
            <field name="model">ztyres_promo.coupon_excel_wizard</field>
            <field name="arch" type="xml">
                <form string="Cargar cupones">
                    <field name="notas_credito_id" invisible="1"/>

                    <div class="alert alert-info" role="alert">
                        <p class="mb-1">
                            <strong>Formato del archivo (.xlsx)</strong>
                        </p>
                        <table class="table table-sm table-bordered bg-white mb-2" style="width:auto;">
                            <thead>
                                <tr>
                                    <th class="text-center">codigo</th>
                                    <th class="text-center">monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>LLA-DUN-19565R15-91H</td><td class="text-end">150</td></tr>
                                <tr><td>LLA-FAL-20555R16-91V</td><td class="text-end">200</td></tr>
                            </tbody>
                        </table>
                        <p class="mb-1">
                            <b>codigo</b>: referencia interna del producto en Odoo.
                            <b>monto</b>: pesos de nota de crédito por
                            <b>cada pieza vendida</b> — no es porcentaje ni monto total.
                        </p>
                        <p class="mb-0">
                            Cargar cupones define el alcance de la promoción como
                            “Cupones por Producto”: los productos del archivo son
                            los únicos participantes.
                        </p>
                    </div>

                    <group>
                        <field name="file" widget="binary" filename="file_name"
                               string="Archivo Excel"/>
                        <field name="file_name" invisible="1"/>
                        <field name="mode" widget="radio"/>
                    </group>

                    <footer>
                        <button name="action_import" string="Importar" type="object"
                                class="btn-primary"
                                attrs="{'invisible': [('file','=',False)]}"/>
                        <button name="action_download_template" string="Descargar plantilla"
                                type="object" class="btn-secondary" icon="fa-download"/>
                        <button string="Cancelar" class="btn-link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_coupon_excel_wizard" model="ir.actions.act_window">
            <field name="name">Cargar cupones desde Excel</field>
            <field name="res_model">ztyres_promo.coupon_excel_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
