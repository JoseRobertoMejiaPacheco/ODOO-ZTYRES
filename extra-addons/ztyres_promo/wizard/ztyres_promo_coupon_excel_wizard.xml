<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="view_coupon_excel_wizard_form" model="ir.ui.view">
            <field name="name">ztyres.promo.coupon.excel.wizard.form</field>
            <field name="model">ztyres_promo.coupon_excel_wizard</field>
            <field name="arch" type="xml">
                <form string="Importar Cupones desde Excel">
                    <sheet>
                        <group>
                            <field name="notas_credito_id" 
                                   string="Nota de Crédito"
                                   required="1" 
                                   invisible="1"
                                   />
                            <label for="file" string="Seleccione archivo Excel"/>
                            <div class="o_row">
                                <field name="file" 
                                       string="Archivo Excel"
                                       required="1"
                                       widget="binary"
                                       filename="file_name"
                                       class="oe_no_button"/>
                                <field name="file_name" 
                                       readonly="1" 
                                       class="oe_inline" 
                                       invisible="1"
                                       nolabel="1"/>
                            </div>
                        </group>
                            <div class="alert alert-info" role="alert">
                                <p><strong>Formato del archivo:</strong></p>
                                <ul>
                                    <li>Columna 'codigo': Código del producto</li>
                                    <li>Columna 'monto': Monto del cupón</li>
                                </ul>
                            </div>
                    </sheet>
                    <footer>
                        <button name="action_import" 
                                string="Importar" 
                                type="object" 
                                class="oe_highlight"/>
                        <button string="Cancelar" 
                                class="btn-secondary" 
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Acción del wizard -->
        <record id="action_coupon_excel_wizard" model="ir.actions.act_window">
            <field name="name">Importar Cupones desde Excel</field>
            <field name="res_model">ztyres_promo.coupon_excel_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>