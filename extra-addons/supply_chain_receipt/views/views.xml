<!-- actions / views del wizard -->
<record id="action_add_location_wizard" model="ir.actions.act_window">
  <field name="name">Agregar Ubicaciones</field>
  <field name="res_model">supply_chain_receipt.add_location_wizard</field>
  <field name="view_mode">form</field>
  <field name="target">new</field>
</record>

<record id="view_add_location_wizard_form" model="ir.ui.view">
  <field name="name">supply_chain_receipt.add_location_wizard.form</field>
  <field name="model">supply_chain_receipt.add_location_wizard</field>
  <field name="arch" type="xml">
    <form string="Agregar ubicaciones">
      <header>
        <button name="action_confirm" type="object" string="Agregar a la línea" class="btn-primary"/>
        <button special="cancel" string="Cancelar"/>
      </header>
      <sheet>
        <group>
          <field name="receipt_line_id" readonly="1"/>
          <field name="product_id" readonly="1"/>
        </group>
        <field name="line_ids">
          <tree editable="bottom">
            <field name="entry_text"/>
            <field name="location_id"/>
            <field name="lot_id"/>
            <field name="product_uom_qty"/>
          </tree>
          <form string="Captura">
            <group>
              <field name="entry_text"/>
              <field name="location_id"/>
              <field name="lot_id"/>
              <field name="product_uom_qty"/>
            </group>
          </form>
        </field>
      </sheet>
    </form>
  </field>
</record>

    <!-- Top menu item -->

    <menuitem name="supply_chain_receipt" id="supply_chain_receipt.menu_root" />

    <!-- menu categories -->

    <menuitem name="Menu 1" id="supply_chain_receipt.menu_1" parent="supply_chain_receipt.menu_root" />
    <!-- <menuitem name="Menu 2" id="supply_chain_receipt.menu_2"
    parent="supply_chain_receipt.menu_root"/> -->

    <!-- actions -->

    <menuitem name="List" id="supply_chain_receipt.menu_1_list" parent="supply_chain_receipt.menu_1"
      action="supply_chain_receipt.action_window" />
    <!-- <menuitem name="Server to list" id="supply_chain_receipt"
    parent="supply_chain_receipt.menu_2"
              action="supply_chain_receipt.action_server"/> -->

  </data>
</odoo>