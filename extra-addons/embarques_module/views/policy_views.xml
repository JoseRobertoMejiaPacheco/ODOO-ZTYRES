<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_policy_tree" model="ir.ui.view">
        <field name="name">embarques.discount.policy.tree</field>
        <field name="model">embarques.discount.policy</field>
        <field name="arch" type="xml">
            <tree string="Opciones de Descuento" editable="bottom" multi_edit="1">
                <field name="capacity" invisible="1"/>
                <field name="unidad_id" string="Rango" options="{'no_create': True}"/>
                <field name="percentage"/>
                <field name="name" readonly="1" optional="show"/>
                <field name="zona_ids" widget="many2many_tags"
                       options="{'no_create': True}" optional="hide"/>
                <field name="destination_count" readonly="1" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_policy_search" model="ir.ui.view">
        <field name="name">embarques.discount.policy.search</field>
        <field name="model">embarques.discount.policy</field>
        <field name="arch" type="xml">
            <search string="Opciones de Descuento">
                <field name="name"/>
                <field name="unidad_id"/>
                <field name="percentage"/>
                <filter string="Archivadas" name="inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_policy" model="ir.actions.act_window">
        <field name="name">Rangos y Descuentos</field>
        <field name="res_model">embarques.discount.policy</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Agrega combinaciones de rango y descuento</p>
            <p>Después selecciona varias opciones como etiquetas en cada destino.</p>
        </field>
    </record>
</odoo>
