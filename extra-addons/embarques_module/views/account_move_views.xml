<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_embarque" model="ir.ui.view">
        <field name="name">account.move.form.embarque</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_payment_term_id']" position="after">
                <field name="embarque_ids" widget="many2many_tags" readonly="1"
                       attrs="{'invisible': ['|', ('embarque_ids','=',[]),
                                                  ('move_type','not in',('out_invoice','out_refund'))]}"/>
                <field name="embarque_discount_percentage" invisible="1"/>
                <field name="embarque_discount_summary" readonly="1"
                       attrs="{'invisible': [('embarque_discount_summary','in',(False,''))]}"/>
                <field name="embarque_discount_amount" readonly="1"
                       attrs="{'invisible': [('embarque_discount_amount','=',0)]}"/>
                <field name="embarque_logistic_nc_id" readonly="1"
                       options="{'no_create': True}"
                       attrs="{'invisible': [('embarque_logistic_nc_id','=',False)]}"/>
                <field name="embarque_logistic_nc_new_flow" invisible="1"/>
            </xpath>

            <!-- Campos de trazabilidad técnica: el porcentaje logístico no
                 se presenta como descuento de línea porque se entrega sólo
                 mediante Nota de Crédito. -->
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount']"
                   position="after">
                <field name="embarque_discount_percentage" invisible="1"/>
                <field name="embarque_discount_amount" invisible="1"/>
                <field name="embarque_original_percentage" invisible="1"/>
                <field name="embarque_source_line_id" invisible="1"/>
                <field name="embarque_discount_applied" invisible="1"/>
                <field name="embarque_base_discount" invisible="1"/>
                <field name="embarque_base_discount_set" invisible="1"/>
            </xpath>

        </field>
    </record>
</odoo>
