<odoo>
  <data>


    <record id="view_order_form_inherit" model="ir.ui.view">
      <field name="name">sale.order.form.inherit</field>
      <field name="model">sale.order</field>
      <field name="inherit_id" ref="sale.view_order_form"/>
      <field name="arch" type="xml">
          <xpath expr="//field[@name='partner_shipping_id']" position="after">
              <field name="promo_sel" 
              readonly="1"
              widget="many2many_tags"
              context="{'active_test': False}"
              />
          </xpath>
      </field>
    </record>


          <!-- Vista árbol -->
          <record id="view_ztyres_promo_elige_tree" model="ir.ui.view">
              <field name="name">ztyres.promo.elige.tree</field>
              <field name="model">ztyres_promo_elige.ztyres_promo_elige</field>
              <field name="arch" type="xml">
                  <tree>
                      <field name="nombre"/>
                      <field name="start_date"/>
                      <field name="end_date"/>
                      <field name="status"/>
                      <field name="min_qty"/>
                      <field name="active" invisible="1"/>
                  </tree>
              </field>
          </record>
  

        <!-- VISTA FORM PRINCIPAL -->
        <record id="view_ztyres_promo_elige_form" model="ir.ui.view">
            <field name="name">ztyres.promo.elige.form</field>
            <field name="model">ztyres_promo_elige.ztyres_promo_elige</field>
            <field name="priority">1</field> <!-- ESTO ASEGURA QUE ESTA VISTA SE USE -->
            <field name="arch" type="xml">

                <form string="Promoción Eligé">
<header>

    <!-- Statusbar -->
    <field name="status" widget="statusbar"
           statusbar_visible="draft,approve_p,done,cancel"
           statusbar_colors='{"approve_p":"blue","done":"green","cancel":"red"}'/>

    <!-- PROBAR (draft) -->
    <button name="action_approve_p"
            type="object"
            string="Aprobar"
            class="btn-primary"
            attrs="{'invisible': [('status', '!=', 'draft')]}"/>

    <!-- CONFIRMAR (approve_p) -->
    <button name="action_done"
            type="object"
            string="Confirmar"
            class="btn-success"
            attrs="{'invisible': [('status', '!=', 'approve_p')]}"/>

    <!-- CANCELAR (visible en draft, approve_p, done) -->
    <button name="action_cancel"
            type="object"
            string="Cancelar"
            class="btn-danger"
            attrs="{'invisible': [('status', '=', 'cancel')]}"/>

    <!-- VOLVER A BORRADOR (cancel) -->
    <button name="action_reset_to_draft"
            type="object"
            string="Volver a Borrador"
            class="btn-secondary"
            attrs="{'invisible': [('status', '!=', 'cancel')]}"/>

</header>

                    <sheet>

                        <group>
                            <field name="active" invisible="1"/>
                            <field name="nombre"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="min_qty"/>
                            <field name="brand_ids" widget="many2many_tags"/>
                        </group>

                        <!-- PROMOCIÓN 1 -->
                        <group string="Promoción 1">
                            <group>
                                <field name="property_payment_term_id_1"/>
                                <field name="percent_1"/>
                            </group>
                        </group>

                        <!-- PROMOCIÓN 2 -->
                        <group string="Promoción 2">
                            <group>
                                <field name="property_payment_term_id_2"/>
                                <field name="percent_2"/>
                            </group>
                        </group>

                        <button name="action_view_applied_invoices"
                                type="object"
                                string="Ver Facturas Con Promoción"
                                class="btn-primary"/>

                        <field name="invoice_ids"/>

                    </sheet>

                </form>

            </field>
        </record>

  
          <!-- Vista búsqueda -->
          <record id="view_ztyres_promo_elige_search" model="ir.ui.view">
              <field name="name">ztyres.promo.elige.search</field>
              <field name="model">ztyres_promo_elige.ztyres_promo_elige</field>
              <field name="arch" type="xml">
                  <search>
                      <field name="nombre"/>
                      <field name="brand_ids"/>
                      <filter string="Activas" name="active" domain="[('active','=',True)]"/>
                      <filter string="Borrador" name="draft" domain="[('status','=','draft')]"/>
                      <filter string="Aprobadas" name="approve_p" domain="[('status','=','approve_p')]"/>
                      <filter string="Confirmadas" name="done" domain="[('status','=','done')]"/>
                      <filter string="Canceladas" name="cancel" domain="[('status','=','cancel')]"/>
                      <filter string="Promociones vigentes" name="current" domain="[('start_date','&lt;=',context_today()),('end_date','&gt;=',context_today())]"/>
                  </search>
              </field>
          </record>
  
          <!-- Acción de ventana -->
          <record id="action_ztyres_promo_elige" model="ir.actions.act_window">
              <field name="name">Promociones Elige</field>
              <field name="res_model">ztyres_promo_elige.ztyres_promo_elige</field>
              <field name="view_mode">tree,form</field>
              <field name="help" type="html">
                  <p class="o_view_nocontent_smiling_face">Crea una nueva promoción Elige
                  </p>
              </field>
          </record>
          <!-- Menús (colocados al final como solicitaste) -->
  </data>
</odoo>