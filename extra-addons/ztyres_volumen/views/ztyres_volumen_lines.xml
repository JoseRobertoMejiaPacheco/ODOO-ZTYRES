<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Vista Tree (Lista) -->
        <record id="view_ztyres_volumen_lines_tree" model="ir.ui.view">
            <field name="name">ztyres_volumen.lines.tree</field>
            <field name="model">ztyres_volumen.lines</field>
            <field name="arch" type="xml">
                <tree string="Ztyres Volumen Lines">
                    <field name="move_type"/>
                    <field name="move_id"/>
                    <field name="rfc"/>
                    <field name="product_name"/>
                    <field name="product_code"/>
                    <field name="product_brand"/>
                    <field name="date"/>
                    <field name="quantity"/>
                    <field name="price_subtotal"/>
                    <field name="price_subtotal_bs"/>
                    <field name="partner_id"/>
                    <field name="partner_name"/>
                    <field name="group_id"/>
                    <field name="sale_origin"/>
                    <field name="list_origin"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Vista Formulario (Form) -->
        <record id="view_ztyres_volumen_lines_form" model="ir.ui.view">
            <field name="name">ztyres_volumen.lines.form</field>
            <field name="model">ztyres_volumen.lines</field>
            <field name="arch" type="xml">
                <form string="Ztyres Volumen Lines">
                    <sheet>
                        <group>
                            <group>
                                <field name="move_type"/>
                                <field name="move_id"/>
                            </group>
                            <group>
                                <field name="product_name"/>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="product_code"/>
                                <field name="product_brand"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="quantity"/>
                                <field name="price_subtotal"/>
                                <field name="price_subtotal_bs"/>
                            </group>
                            <group>
                                <field name="partner_id"/>
                                <field name="partner_name"/>
                                <field name="group_id"/>
                            </group>
                            <group>
                                <field name="sale_origin"/>
                                <field name="list_origin"/>
                                <field name="state"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acción para abrir la lista/formulario -->
        <record id="lines_action" model="ir.actions.act_window">
            <field name="name">Detalle</field>
            <field name="res_model">ztyres_volumen.lines</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
