    <!-- Nuevo Grupo    -->
    <!-- ============== -->
    <record id="group_unapplied_receivables_report_user" model="res.groups">
        <field name="name">Pagos sin Aplicar / Usuario</field>
        <!-- Si no quieres que aparezca en Contabilidad, usa: ref="base.module_category_hidden" -->
