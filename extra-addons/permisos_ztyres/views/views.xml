<odoo>
  <data>
<record id="view_move_form_permisos" model="ir.ui.view">
    <field name="name">account.move.form.permisos.ztyres</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">

        <xpath expr="//group[@id='header_right_group']//label[@for='journal_id']" position="replace">
            <label for="journal_id"
                   groups="account.group_account_readonly,permisos_ztyres.group_permisos_especiales_facturacion"
                   invisible="context.get('default_journal_id') and context.get('move_type', 'entry') != 'entry'"/>
        </xpath>

        <xpath expr="//div[@name='journal_div']" position="replace">
            <div name="journal_div"
                 class="d-flex"
                 groups="account.group_account_readonly,permisos_ztyres.group_permisos_especiales_facturacion"
                 invisible="context.get('default_journal_id') and context.get('move_type', 'entry') != 'entry'">
                <field name="journal_id"
                       options="{'no_create': True, 'no_open': True}"
                       attrs="{'readonly': [('posted_before', '=', True), ('name', 'not in', (False, '', '/'))]}"/>
                <span class="oe_inline o_form_label mx-3"
                      groups="base.group_multi_currency"
                      attrs="{'invisible': [('move_type', '=', 'entry')]}"> in </span>
                <field name="currency_id"
                       groups="base.group_multi_currency"
                       attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('move_type', '=', 'entry')]}"/>
            </div>
        </xpath>

    </field>
</record>
  </data>
</odoo>