<odoo>
    <data>
        <record id="view_move_form_permisos" model="ir.ui.view">
            <field name="name">account.move.form.permisos.ztyres</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">

                <xpath expr="//group[@id='header_right_group']//label[@for='journal_id']"
                    position="replace">
                    <label for="journal_id"
                        groups="account.group_account_readonly,permisos_ztyres.group_permisos_especiales_facturacion"
                        invisible="context.get('default_journal_id') and context.get('move_type', 'entry') != 'entry'" />
                </xpath>

                <xpath expr="//div[@name='journal_div']" position="replace">
                    <div name="journal_div"
                        class="d-flex"
                        groups="account.group_account_readonly,permisos_ztyres.group_permisos_especiales_facturacion"
                        invisible="context.get('default_journal_id') and context.get('move_type', 'entry') != 'entry'">
                        <field name="journal_id"
                            options="{'no_create': True, 'no_open': True}"
                            attrs="{'readonly': [('posted_before', '=', True), ('name', 'not in', (False, '', '/'))]}" />
                        <span class="oe_inline o_form_label mx-3"
                            groups="base.group_multi_currency"
                            attrs="{'invisible': [('move_type', '=', 'entry')]}"> in </span>
                        <field name="currency_id"
                            groups="base.group_multi_currency"
                            attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('move_type', '=', 'entry')]}" />
                    </div>
                </xpath>

            </field>
        </record>


        <!-- product.template -->
        <record id="ztyres_product_template_form_procurement_button" model="ir.ui.view">
            <field name="name">product.template.form.procurement.button.ztyres</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="stock.product_template_form_view_procurement_button" />
            <field name="arch" type="xml">

                <!-- Wrapper general del button_box -->
                <xpath expr="//div[@name='button_box']/t[@groups='stock.group_stock_user']"
                    position="attributes">
                    <attribute name="groups">
                        stock.group_stock_user,permisos_ztyres.group_permisos_especiales_ventas,permisos_ztyres.group_permisos_especiales_facturacion</attribute>
                </xpath>

                <!-- Botón In/Out -->
                <xpath expr="//button[@name='action_view_stock_move_lines']" position="attributes">
                    <attribute name="groups">
                        stock.group_stock_user,permisos_ztyres.group_permisos_especiales_ventas,permisos_ztyres.group_permisos_especiales_facturacion</attribute>
                </xpath>

                <!-- Lot/Serial Numbers -->
                <xpath expr="//button[@name='action_open_product_lot']" position="attributes">
                    <attribute name="groups">
                        stock.group_production_lot,permisos_ztyres.group_permisos_especiales_ventas,permisos_ztyres.group_permisos_especiales_facturacion</attribute>
                </xpath>

                <!-- Putaway Rules -->
                <xpath expr="//button[@name='action_view_related_putaway_rules']"
                    position="attributes">
                    <attribute name="groups">
                        stock.group_stock_multi_locations,permisos_ztyres.group_permisos_especiales_ventas,permisos_ztyres.group_permisos_especiales_facturacion</attribute>
                </xpath>

                <!-- Storage Capacities -->
                <xpath expr="//button[@name='action_view_storage_category_capacity']"
                    position="attributes">
                    <attribute name="groups">
                        stock.group_stock_storage_categories,permisos_ztyres.group_permisos_especiales_ventas,permisos_ztyres.group_permisos_especiales_facturacion</attribute>
                </xpath>

            </field>
        </record>

        <!-- product.product -->
        <record id="ztyres_product_form_procurement_button" model="ir.ui.view">
            <field name="name">product.form.procurement.button.ztyres</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="stock.product_form_view_procurement_button" />
            <field name="arch" type="xml">

                <xpath expr="//div[@name='button_box']/t[@groups='stock.group_stock_user']"
                    position="attributes">
                    <attribute name="groups">
                        stock.group_stock_user,permisos_ztyres.group_permisos_especiales_ventas,permisos_ztyres.group_permisos_especiales_facturacion</attribute>
                </xpath>

                <xpath expr="//button[@name='action_view_stock_move_lines']" position="attributes">
                    <attribute name="groups">
                        stock.group_stock_user,permisos_ztyres.group_permisos_especiales_ventas,permisos_ztyres.group_permisos_especiales_facturacion</attribute>
                </xpath>

                <xpath expr="//button[@name='action_open_product_lot']" position="attributes">
                    <attribute name="groups">
                        stock.group_production_lot,permisos_ztyres.group_permisos_especiales_ventas,permisos_ztyres.group_permisos_especiales_facturacion</attribute>
                </xpath>

                <xpath expr="//button[@name='action_view_related_putaway_rules']"
                    position="attributes">
                    <attribute name="groups">
                        stock.group_stock_multi_locations,permisos_ztyres.group_permisos_especiales_ventas,permisos_ztyres.group_permisos_especiales_facturacion</attribute>
                </xpath>

                <xpath expr="//button[@name='action_view_storage_category_capacity']"
                    position="attributes">
                    <attribute name="groups">
                        stock.group_stock_storage_categories,permisos_ztyres.group_permisos_especiales_ventas,permisos_ztyres.group_permisos_especiales_facturacion</attribute>
                </xpath>

            </field>
        </record>

    </data>
</odoo>