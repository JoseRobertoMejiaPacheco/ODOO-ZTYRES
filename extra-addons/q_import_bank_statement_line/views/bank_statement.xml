<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="bank_statement_import_line_wizard" model="ir.ui.view">
            <field name="name">bank.statement.import.line.wizard</field>
            <field name="model">account.bank.statement.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="file_name" invisible="1"/>
                            <field name="file" filename="file_name"/>
                            <field name="file_opt" widget="radio"/>
                        </group>
                        <group>
                            <field name="import_journal_id" options="{'no_create_edit': True,'no_create': True}"/>
                        </group>
                    </group>

                    <group>
                        <group string="Download Sample XLS and CSV Files">
                            <field name="down_samp_file" widget="checkbox"/>
                            <field name="sample_option" widget="radio" attrs="{'invisible': [('down_samp_file', '=', False)]}"/>
                            <button name="download_auto" string="Download Sample File" type="object" class="oe_highlight" attrs="{'invisible': [('down_samp_file', '=', False)]}"/>
                        </group>
                    </group>

                    <footer>
                        <button name="import_file" string="Import" type="object" class="btn-primary"/>
                        <button name="cancel" string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_bank_statement_import_line_wizard" model="ir.actions.act_window">
            <field name="name">Import Bank Statement Lines</field>
            <field name="res_model">account.bank.statement.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="main_menu_bank_statement" name="Import Bank Statement" parent="account.menu_finance_configuration" action="action_bank_statement_import_line_wizard"/>
        
    </data>
</odoo>