<odoo>
    <record id="view_it_service_tree" model="ir.ui.view">
        <field name="name">ztyres.it.service.tree</field>
        <field name="model">ztyres.it.service</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="equipment_id"/>
                <field name="mobile_id"/>
                <field name="service_type"/>
                <field name="attended_by"/>
                <field name="state"/>
                <field name="cost"/>
            </tree>
        </field>
    </record>
    <record id="view_it_service_form" model="ir.ui.view">
        <field name="name">ztyres.it.service.form</field>
        <field name="model">ztyres.it.service</field>
        <field name="arch" type="xml">
            <form string="Servicio de TI">
                <header>
                    <button name="action_progress" type="object" string="Iniciar" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_done" type="object" string="Marcar realizado" class="btn-primary"
                            attrs="{'invisible': [('state', 'in', ['done', 'cancelled'])]}"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            attrs="{'invisible': [('state', 'in', ['done', 'cancelled'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,progress,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="equipment_id"/>
                            <field name="mobile_id"/>
                            <field name="service_type"/>
                        </group>
                        <group>
                            <field name="requested_by"/>
                            <field name="attended_by"/>
                            <field name="cost"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Servicio">
                            <group>
                                <field name="description"/>
                                <field name="work_done"/>
                                <field name="result"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_it_service" model="ir.actions.act_window">
        <field name="name">Servicios / Historial</field>
        <field name="res_model">ztyres.it.service</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
