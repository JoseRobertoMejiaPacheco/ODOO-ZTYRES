<odoo>
    <record id="view_it_assignment_tree" model="ir.ui.view">
        <field name="name">ztyres.it.assignment.tree</field>
        <field name="model">ztyres.it.assignment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="equipment_id"/>
                <field name="mobile_id"/>
                <field name="user_id"/>
                <field name="area"/>
                <field name="position"/>
                <field name="date_from"/>
                <field name="date_to"/>
            </tree>
        </field>
    </record>
    <record id="view_it_assignment_form" model="ir.ui.view">
        <field name="name">ztyres.it.assignment.form</field>
        <field name="model">ztyres.it.assignment</field>
        <field name="arch" type="xml">
            <form string="Asignación">
                <header>
                    <button name="action_print_resguardo" type="object"
                            string="Imprimir resguardo (Excel)" class="btn-primary"
                            attrs="{'invisible': [('equipment_id', '=', False)]}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="mobile_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="area"/>
                            <field name="position"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="notes"/>
                    </group>
                    <group string="Formato de resguardo - Entrega" attrs="{'invisible': [('equipment_id', '=', False)]}">
                        <field name="physical_condition"/>
                        <field name="physical_condition_other"
                               attrs="{'invisible': [('physical_condition', '!=', 'other')]}"/>
                    </group>
                    <group string="Formato de resguardo - Devolución" attrs="{'invisible': [('equipment_id', '=', False)]}">
                        <field name="return_reason"/>
                        <field name="return_reason_other"
                               attrs="{'invisible': [('return_reason', '!=', 'other')]}"/>
                        <field name="return_condition"/>
                        <field name="return_notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_it_assignment" model="ir.actions.act_window">
        <field name="name">Asignaciones</field>
        <field name="res_model">ztyres.it.assignment</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
