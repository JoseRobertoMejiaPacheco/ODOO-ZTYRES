<odoo>
    <record id="view_it_maintenance_tree" model="ir.ui.view">
        <field name="name">ztyres.it.maintenance.tree</field>
        <field name="model">ztyres.it.maintenance</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'planned' and planned_date &lt; context_today()"
                  decoration-warning="state == 'planned' and planned_date &lt;= context_today()">
                <field name="name"/>
                <field name="planned_date"/>
                <field name="equipment_id"/>
                <field name="mobile_id"/>
                <field name="maintenance_type"/>
                <field name="responsible_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_it_maintenance_form" model="ir.ui.view">
        <field name="name">ztyres.it.maintenance.form</field>
        <field name="model">ztyres.it.maintenance</field>
        <field name="arch" type="xml">
            <form string="Mantenimiento">
                <header>
                    <button name="action_progress" type="object" string="Iniciar" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'planned')]}"/>
                    <button name="action_done" type="object" string="Marcar realizado" class="btn-primary"
                            attrs="{'invisible': [('state', 'in', ['done', 'cancelled'])]}"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            attrs="{'invisible': [('state', 'in', ['done', 'cancelled'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,progress,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="planned_date"/>
                            <field name="equipment_id"/>
                            <field name="mobile_id"/>
                            <field name="maintenance_type"/>
                        </group>
                        <group>
                            <field name="frequency_months"/>
                            <field name="responsible_id"/>
                            <field name="completion_date"/>
                            <field name="next_maintenance_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="result"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_it_maintenance_calendar" model="ir.ui.view">
        <field name="name">ztyres.it.maintenance.calendar</field>
        <field name="model">ztyres.it.maintenance</field>
        <field name="arch" type="xml">
            <calendar string="Mantenimientos" date_start="planned_date" color="responsible_id">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="mobile_id"/>
                <field name="responsible_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>
    <record id="action_it_maintenance" model="ir.actions.act_window">
        <field name="name">Mantenimientos</field>
        <field name="res_model">ztyres.it.maintenance</field>
        <field name="view_mode">tree,form,calendar</field>
    </record>
</odoo>
