<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_import_wizard_step1" model="ir.ui.view">
        <field name="name">sale.import.wizard.step1</field>
        <field name="model">sale.import.wizard</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form string="Importar Pedido - Paso 1 de 3: Datos Generales">
                <sheet>
                    <div class="alert alert-primary" role="alert">
                        <strong>Paso 1 / 3</strong> - Datos Generales del Pedido
                    </div>
                    <group>
                        <group string="Cliente y Lista de Precio">
                            <field name="partner_id" options="{'no_create': True}" required="1"/>
                            <field name="pricelist_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Politica de Facturacion">
                            <field name="invoice_policy" widget="radio" required="1" nolabel="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <ul class="mb0">
                            <li><strong>Politica de Facturacion:</strong> aplica solo a este pedido, sin modificar la configuracion de los productos.</li>
                            <li><strong>Lista de Precio:</strong> si el precio en Excel es 0, se toma automaticamente de la lista seleccionada.</li>
                        </ul>
                    </div>
                    <field name="state" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_next_step1" string="Siguiente" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_sale_import_wizard_step2" model="ir.ui.view">
        <field name="name">sale.import.wizard.step2</field>
        <field name="model">sale.import.wizard</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Importar Pedido - Paso 2 de 3: Cargar Excel">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>Paso 2 / 3</strong> - Cargar Archivo Excel
                    </div>
                    <group string="Resumen Paso 1">
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="pricelist_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="invoice_policy" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Archivo Excel"/>
                    <group>
                        <field name="excel_file" widget="binary" filename="excel_filename"
                               string="Archivo .xlsx" required="1"/>
                        <field name="excel_filename" invisible="1"/>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        <strong>Formato del archivo:</strong>
                        <ul class="mb0 mt4">
                            <li><strong>Columna A:</strong> Codigo interno del producto</li>
                            <li><strong>Columna B:</strong> Cantidad</li>
                            <li><strong>Columna C:</strong> Precio unitario (0 = usar lista de precios)</li>
                        </ul>
                        <small>La fila 1 es encabezado y se omite. Datos desde fila 2.</small>
                    </div>
                    <field name="state" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_parse_excel" string="Procesar Excel" type="object" class="btn-primary"/>
                    <button name="action_back_step2" string="Atras" type="object" class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_sale_import_wizard_step3" model="ir.ui.view">
        <field name="name">sale.import.wizard.step3</field>
        <field name="model">sale.import.wizard</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <form string="Importar Pedido - Paso 3 de 3: Confirmar">
                <sheet>
                    <div class="alert alert-success" role="alert">
                        <strong>Paso 3 / 3</strong> - Previsualizacion y Confirmacion
                    </div>
                    <group string="Parametros del Pedido">
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="pricelist_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="invoice_policy" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-danger" attrs="{'invisible': [('has_errors', '=', False)]}">
                        <strong>Atencion:</strong> Hay lineas con errores marcadas en rojo. No seran importadas.
                    </div>
                    <div class="alert alert-success" attrs="{'invisible': [('has_errors', '=', True)]}">
                        <strong>Listo:</strong> Todos los productos fueron encontrados. Revise y confirme.
                    </div>
                    <field name="line_ids" nolabel="1">
                        <tree editable="bottom"
                              decoration-danger="not product_found or error_msg"
                              decoration-muted="not include">
                            <field name="include" string="Incluir"/>
                            <field name="product_code" string="Codigo"/>
                            <field name="product_id" string="Producto" optional="show"/>
                            <field name="product_name" string="Nombre" optional="show"/>
                            <field name="product_found" column_invisible="1"/>
                            <field name="qty" string="Cantidad"/>
                            <field name="price_unit_excel" string="Precio Excel" optional="show"/>
                            <field name="price_unit_list" string="Precio Lista" optional="show"/>
                            <field name="pricelist_used" string="Fuente" optional="show"/>
                            <field name="price_unit_final" string="Precio Unit."/>
                            <field name="subtotal" string="Subtotal"/>
                            <field name="tax_amount" string="Impuestos" optional="show"/>
                            <field name="total" string="Total"/>
                            <field name="error_msg" string="Error" optional="show"/>
                        </tree>
                    </field>
                    <group>
                        <group/>
                        <group string="Totales">
                            <field name="total_subtotal" string="Subtotal" readonly="1"/>
                            <field name="total_taxes" string="Impuestos" readonly="1"/>
                            <field name="total_total" string="Total" readonly="1"/>
                        </group>
                    </group>
                    <field name="state" invisible="1"/>
                    <field name="has_errors" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_create_sale_order" string="Crear Pedido de Venta"
                            type="object" class="btn-primary"
                            confirm="Confirmar creacion del pedido con las lineas seleccionadas?"/>
                    <button name="action_export_excel" string="Exportar Excel"
                            type="object" class="btn-secondary"/>
                    <button name="action_back_step3" string="Atras"
                            type="object" class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Pedido desde Excel</field>
        <field name="res_model">sale.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sale_import_wizard_step1"/>
        <field name="target">new</field>
    </record>

</odoo>
